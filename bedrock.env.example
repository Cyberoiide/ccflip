# ~/.claude/bedrock.env — per-host Bedrock fallback tier for ccflip.
# Sourced by ccflip ONLY when every subscription account is exhausted.
# No file = no Bedrock tier on this host (session pauses at the limit).
#
# Pair with the awsAuthRefresh setting in ~/.claude/settings.json so an
# expired SSO session refreshes itself:
#   "awsAuthRefresh": "aws sso login --profile code-assist-admin"

# --- dellpro (laptop, SSO profile) ---
export CLAUDE_CODE_USE_BEDROCK=1
export AWS_PROFILE=code-assist-admin
export AWS_REGION=eu-west-1

# --- claude-host (EC2, instance role) — use these lines instead ---
# The role has no IAM access to fable model ARNs, and t3code's explicit
# --model flag beats every env var, so ccflip rewrites it to the override.
# export CLAUDE_CODE_USE_BEDROCK=1
# export AWS_REGION=eu-west-3
# export ANTHROPIC_MODEL="claude-opus-5[1m]"
# export CCFLIP_BEDROCK_MODEL_OVERRIDE="claude-opus-5[1m]"
