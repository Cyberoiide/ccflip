# ~/.config/ccflip/policy.env — account containment, enforced by ccflip-watch
# every tick. Guards against anything (cswap import, manual slip) making a
# pinned-only account the default login or re-enabling its rotation.

# Account the default login is forced back to when a pinned-only account
# is found active.
CCFLIP_DEFAULT_ACCOUNT=clement.bosle@sia-partners.com

# Space-separated accounts that may ONLY serve their mapped dirs: kept
# disabled (out of rotation) and never left as the default login.
CCFLIP_PINNED_ONLY="clement.bosle@quiet-mind.io"

# sso-guard (AWS SSO / gcloud keep-alive). Space-separated sso-sessions that
# may open a browser login on their own ("*" = all); the others re-login only
# while in use.
SSO_GUARD_BROWSER=heka
# Renew an AWS SSO access token once it has less life than this.
SSO_GUARD_MIN_MINUTES=15
