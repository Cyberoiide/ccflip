#!/usr/bin/env bash
# sso-guard — keep every AWS SSO session fresh so Bedrock sessions (and the
# litellm gateway, bastion tunnels, kubectl…) never die mid-flight with
# "Token is expired".
#
# Sessions are discovered from ~/.aws/config ([sso-session] blocks plus the
# first profile referencing each). Silent while an access token has life.
# When one runs low, a plain STS call lets botocore mint a fresh token from
# the SSO refresh token — no browser. Only when the refresh token itself is
# dead does it open the browser login (one click against a live IdP session),
# and only on a graphical session.
#
# Scheduling is adaptive: each run arms a transient timer to wake ~1 min
# before the earliest token crosses the threshold. The static hourly timer
# is only the reboot-safe backstop.
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

MIN_SECONDS=$(( ${SSO_GUARD_MIN_MINUTES:-45} * 60 ))
CONFIG="${AWS_CONFIG_FILE:-$HOME/.aws/config}"

# Emit one "session<TAB>start_url<TAB>first_profile" line per sso-session.
sessions() {
    awk '
        /^\[sso-session /   { sec="s"; name=$2; sub(/\]$/,"",name); next }
        /^\[profile /       { sec="p"; prof=$2; sub(/\]$/,"",prof); next }
        /^\[/               { sec=""; next }
        sec=="s" && $1=="sso_start_url" { url[name]=$3 }
        sec=="p" && $1=="sso_session"   { if (!(($3) in prof_of)) prof_of[$3]=prof }
        END { for (n in url) printf "%s\t%s\t%s\n", n, url[n], prof_of[n] }
    ' "$CONFIG"
}

expiry_for() { # $1 = start_url -> newest expiresAt epoch (0 if none)
    local best=0 f exp e
    for f in "$HOME"/.aws/sso/cache/*.json; do
        [[ -e "$f" ]] || continue
        exp=$(jq -r --arg u "$1" 'select(.startUrl == $u) | .expiresAt // empty' "$f" 2>/dev/null) || continue
        [[ -n "$exp" ]] || continue
        e=$(date -d "$exp" +%s 2>/dev/null) || continue
        (( e > best )) && best=$e
    done
    echo "$best"
}

rc=0
now=$(date +%s)
min_exp=0
track() { if (( $1 > 0 )) && (( min_exp == 0 || $1 < min_exp )); then min_exp=$1; fi; }

while IFS=$'\t' read -r name url profile; do
    [[ -n "$profile" ]] || continue # nothing consumes this session
    e=$(expiry_for "$url")
    if (( e - now > MIN_SECONDS )); then track "$e"; continue; fi

    # Access token low: botocore mints a fresh one from the SSO refresh
    # token if the IdC session still lives — a plain STS call triggers it.
    aws sts get-caller-identity --profile "$profile" >/dev/null 2>&1 || true
    e=$(expiry_for "$url")
    if (( e - now > MIN_SECONDS )); then
        echo "sso-guard: $name access token refreshed silently"
        track "$e"; continue
    fi

    if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        command -v notify-send >/dev/null 2>&1 && \
            notify-send -u critical "sso-guard" "AWS SSO session '$name' expiring — complete the login in the browser"
        if aws sso login --sso-session "$name"; then
            track "$(expiry_for "$url")"
        else
            rc=1
        fi
    else
        echo "sso-guard: '$name' needs interactive login (no display): aws sso login --sso-session $name" >&2
        rc=1
    fi
done < <(sessions)

# Adaptive re-arm: wake ~1 min before the earliest token dips under the
# threshold. Failure retries in 10 min; no data falls back to the hourly
# backstop timer. Clamped to [5 min, 6 h].
if command -v systemd-run >/dev/null 2>&1; then
    if (( rc != 0 )); then
        delay=600
    elif (( min_exp > 0 )); then
        delay=$(( min_exp - $(date +%s) - MIN_SECONDS - 60 ))
        if (( delay < 300 )); then delay=300; fi
        if (( delay > 21600 )); then delay=21600; fi
    else
        delay=0
    fi
    if (( delay > 0 )); then
        systemctl --user stop sso-guard-next.timer >/dev/null 2>&1 || true
        systemd-run --user --quiet --collect --unit sso-guard-next \
            --on-active="${delay}s" systemctl --user start sso-guard.service \
            && echo "sso-guard: next check in $(( delay / 60 )) min"
    fi
fi
exit "$rc"
