#!/usr/bin/env bash
# sso-guard — keep every AWS SSO session fresh so Bedrock sessions (and the
# litellm gateway, bastion tunnels, kubectl…) never die mid-flight with
# "Token is expired".
#
# Sessions are discovered from ~/.aws/config ([sso-session] blocks plus the
# first profile referencing each). Silent while an access token has life.
# When one runs low, a plain STS call lets botocore mint a fresh token from
# the SSO refresh token — no browser. Only when the refresh token itself is
# dead does it open the browser login (one click against a live IdP session),
# and only on a graphical session.
#
# Sessions are checked in parallel: a browser login can block ~10 min and
# must never delay the others. `sso-guard ensure <session>` does the same for
# one session on demand (the `aws` shim calls it when a command's session has
# expired); `sso-guard login [session...]` for every listed session at once.
#
# Scheduling is adaptive: each run arms a transient timer to wake ~1 min
# before the earliest token crosses the threshold. The static hourly timer
# is only the reboot-safe backstop.
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH:/home/linuxbrew/.linuxbrew/bin"

# SSO_GUARD_* knobs from policy.env, the environment still winning (as in
# ccflip): one place the timer, the aws shim and your shell all read. Parsed,
# not sourced.
POLICY="${CCFLIP_POLICY:-$HOME/.config/ccflip/policy.env}"
if [[ -r "$POLICY" ]]; then
    while IFS='=' read -r k v; do
        k=${k#export }
        [[ $k =~ ^SSO_GUARD_[A-Z_]+$ && -z "${!k:-}" ]] || continue
        v=${v%\"}; v=${v#\"}; v=${v%\'}; v=${v#\'}
        export "$k=$v"
    done <"$POLICY"
fi

# sso-off disables the backstop timer; a run already in flight (or a stale
# sso-guard-next) must then do nothing and not re-arm itself. An explicit
# `sso-guard login` still works.
if [[ ! ${1:-} =~ ^(login|push|receive)$ ]] && ! systemctl --user is-enabled --quiet sso-guard.timer 2>/dev/null; then
    echo "sso-guard: disabled (sso-off), skipping"
    exit 0
fi

MIN_SECONDS=$(( ${SSO_GUARD_MIN_MINUTES:-15} * 60 ))
# Sessions kept alive for good, browser login included, and the ones
# `sso-guard login` logs in to (space-separated; "*" = all). Others are kept
# alive only while in use: an org that caps sessions at 1h would otherwise
# mean a browser tab per hour for a session nothing needs — the aws shim logs
# those in on demand. SSO_GUARD_BROWSER is the old name.
BROWSER_SESSIONS="${SSO_GUARD_SESSIONS:-${SSO_GUARD_BROWSER:-*}}"
CONFIG="${AWS_CONFIG_FILE:-$HOME/.aws/config}"

# Emit one "session<TAB>start_url<TAB>first_profile" line per sso-session.
sessions() {
    awk '
        /^\[sso-session /   { sec="s"; name=$2; sub(/\]$/,"",name); next }
        /^\[profile /       { sec="p"; prof=$2; sub(/\]$/,"",prof); next }
        /^\[/               { sec=""; next }
        sec=="s" && $1=="sso_start_url" { url[name]=$3 }
        sec=="p" && $1=="sso_session"   { if (!(($3) in prof_of)) prof_of[$3]=prof }
        END { for (n in url) printf "%s\t%s\t%s\n", n, url[n], prof_of[n] }
    ' "$CONFIG"
}

# Redeem the cached SSO refresh token directly (refresh_token grant) and write
# the new access token back into the cache file. An STS call does NOT do this:
# it is served from cached role creds (~/.aws/cli/cache) and never touches the
# SSO token, so every run used to fall through to a browser login + consent.
#
# Offline is not a dead session: right after resume the timer fires before
# Wi-Fi is back, and a browser tab opened then loads an error page and sits
# there until the login times out. So no network -> 2 and the caller retries.
refresh_silently() { # $1 = start_url -> 0 refreshed, 1 dead, 2 offline
    local f r tmp err offline=0
    err=$(mktemp)
    for f in "$HOME"/.aws/sso/cache/*.json; do
        [[ -e "$f" ]] || continue
        jq -e --arg u "$1" '.startUrl == $u and .refreshToken and .clientSecret' "$f" >/dev/null 2>&1 || continue
        if ! r=$(aws sso-oidc create-token --output json --region "$(jq -r .region "$f")" \
            --grant-type refresh_token --client-id "$(jq -r .clientId "$f")" \
            --client-secret "$(jq -r .clientSecret "$f")" \
            --refresh-token "$(jq -r .refreshToken "$f")" 2>"$err"); then
            # botocore's EndpointConnectionError / connect and read timeouts
            grep -qE 'endpoint URL' "$err" && offline=1
            continue
        fi
        tmp=$(mktemp "$f.XXXX")
        jq --argjson r "$r" --arg e "$(date -u -d "+$(jq -r .expiresIn <<<"$r") sec" +%FT%TZ)" \
            '.accessToken = $r.accessToken | .refreshToken = ($r.refreshToken // .refreshToken) | .expiresAt = $e' \
            "$f" >"$tmp" && chmod 600 "$tmp" && mv "$tmp" "$f" && { rm -f "$err"; return 0; }
        rm -f "$tmp"
    done
    rm -f "$err"
    return $(( offline ? 2 : 1 ))
}

# Is anything running against this sso-session right now? Scans our own
# processes for `--profile P` / `--profile=P` in argv or AWS_PROFILE=P in
# the start-up env, for every profile P bound to the session. Prints the
# first hit ("pid cmd"). Only consulted when a re-login is due, so cheap.
in_use() { # $1 = session name -> 0 + "pid cmd" if used
    local profs pid env p i
    local -a argv
    profs=" $(awk -v s="$1" '/^\[profile /{p=$2; sub(/\]$/,"",p)} $1=="sso_session" && $3==s {printf "%s ", p}' "$CONFIG")"
    [[ -n "${profs// /}" ]] || return 1
    for pid in /proc/[0-9]*; do
        pid=${pid#/proc/}
        [[ -O /proc/$pid && $pid != "$$" ]] || continue
        # Whole argv elements, not a substring: a shell whose -c script merely
        # mentions a profile must not count as using it.
        mapfile -d '' argv 2>/dev/null </proc/$pid/cmdline || continue
        p=""
        for (( i = 0; i < ${#argv[@]}; i++ )); do
            case ${argv[i]} in
                --profile) p=${argv[i+1]:-} ;;
                --profile=*) p=${argv[i]#--profile=} ;;
                *) continue ;;
            esac
            [[ -n "$p" && "$profs" == *" $p "* ]] && break
            p=""
        done
        if [[ -z "$p" ]]; then
            env=$( { tr '\0' '\n' </proc/$pid/environ; } 2>/dev/null | grep -m1 '^AWS_PROFILE=') || true
            p=${env#AWS_PROFILE=}
            [[ -n "$p" && "$profs" == *" $p "* ]] || continue
        fi
        echo "$pid ${argv[*]:0:6}"; return 0
    done
    return 1
}

# Recent use: every real use of a profile mints role creds into the CLI
# cache, tagged with the account id, at least hourly while use continues
# (role creds live 1h). The ones bank_creds mints keep the mtime of the
# last real use, so they never count as use. Catches pollers
# whose own argv/env carry no profile (only their short-lived children do).
used_recently() { # $1 = session name -> 0 + "acct ... minted HH:MM" if used
    local accts f a
    accts=" $(awk -v s="$1" 'function flush() { if (sess && acct) printf "%s ", acct; sess = 0; acct = "" }
        /^\[/ { flush(); inp = ($0 ~ /^\[profile /); next }
        inp && $1 == "sso_account_id" { acct = $3 }
        inp && $1 == "sso_session" && $3 == s { sess = 1 }
        END { flush() }' "$CONFIG")"
    [[ -n "${accts// /}" ]] || return 1
    while IFS= read -r f; do
        a=$(jq -r '.Credentials.AccountId // empty' "$f" 2>/dev/null) || continue
        if [[ -n "$a" && "$accts" == *" $a "* ]]; then
            echo "acct $a creds minted $(date -r "$f" +%H:%M)"; return 0
        fi
    done < <(find "$HOME/.aws/cli/cache" -maxdepth 1 -name '*.json' -mmin -65 2>/dev/null)
    return 1
}

# The IdC session caps the SSO token, not the role creds minted from it: STS
# creds live out their permission-set duration (1h) even after the session
# ends, and the CLI serves them from ~/.aws/cli/cache without reading the
# token until 15 min before they expire. So right before the end, re-mint
# those of every profile in real use: aws, kubectl and tunnels keep working
# ~45 min past it, a window for the re-login instead of a hard stop.
# shortcut: CLI cache only; the Go/JS SDKs (terraform) still stop at the end.
bank_creds() { # $1 = session name
    local p acct role f m
    while read -r p acct role; do
        f="$HOME/.aws/cli/cache/$(printf '{"accountId":"%s","roleName":"%s","sessionName":"%s"}' \
            "$acct" "$role" "$1" | sha1sum | cut -c1-40).json" # botocore's cache key
        [[ -n "$(find "$f" -mmin -65 2>/dev/null)" ]] || continue # unused: nothing to keep alive
        m=$(stat -c %Y "$f")
        mv "$f" "$f.old"
        if aws sts get-caller-identity --profile "$p" >/dev/null 2>&1 && [[ -e "$f" ]]; then
            rm -f "$f.old"
            touch -d "@$m" "$f"
            echo "sso-guard: $1: $p creds banked until $(date -d "$(jq -r .Credentials.Expiration "$f")" +%H:%M)"
        else
            mv -n "$f.old" "$f"; rm -f "$f.old"
        fi
    done < <(awk -v s="$1" '
        function flush() { if (sess && acct && role) print prof, acct, role; sess = 0; acct = role = "" }
        /^\[/ { flush(); inp = ($0 ~ /^\[profile /); prof = $2; sub(/\]$/, "", prof); next }
        inp && $1 == "sso_account_id" { acct = $3 }
        inp && $1 == "sso_role_name" { role = $3 }
        inp && $1 == "sso_session" && $3 == s { sess = 1 }
        END { flush() }' "$CONFIG")
}

# Headless hosts (SSO_GUARD_PUSH, e.g. an EC2 box with no browser) can't log
# in themselves. `push` (sso-push.path runs it on every token change) sends
# them this machine's access tokens; `receive` there files each one under every
# local session with the same start URL, so session names may differ. No
# refresh token or client secret leaves: the host can't refresh (so it never
# rotates ours) and a stolen copy is worth one hour at most. Pushed again 2 min
# before the session ends, the host banks its own role creds then.
if [[ ${1:-} == push ]]; then
    rc=0
    for h in ${SSO_GUARD_PUSH:-}; do
        jq -c 'select(.startUrl and .accessToken and .expiresAt) | {startUrl, region, accessToken, expiresAt}' \
            "$HOME"/.aws/sso/cache/*.json 2>/dev/null \
            | ssh -o BatchMode=yes -o ConnectTimeout=10 "$h" '~/.local/bin/sso-guard receive' \
            || { echo "sso-guard: push to $h failed" >&2; rc=1; }
    done
    exit "$rc"
fi
if [[ ${1:-} == receive ]]; then
    mkdir -p "$HOME/.aws/sso/cache"
    while IFS= read -r t; do
        u=$(jq -r .startUrl <<<"$t")
        e=$(date -d "$(jq -r .expiresAt <<<"$t")" +%s)
        while IFS=$'\t' read -r name url _; do
            [[ "$url" == "$u" ]] || continue
            f="$HOME/.aws/sso/cache/$(printf %s "$name" | sha1sum | cut -c1-40).json"
            old=$(jq -r '.expiresAt // empty' "$f" 2>/dev/null) || old=""
            if (( e > $(date -d "${old:-@0}" +%s 2>/dev/null || echo 0) )); then
                tmp=$(mktemp "$f.XXXX") # 0600
                printf '%s\n' "$t" >"$tmp" && mv "$tmp" "$f"
                echo "sso-guard: $(hostname): $name token until $(date -d "@$e" +%H:%M)"
            fi
            if (( e > $(date +%s) && e - $(date +%s) <= 180 )); then bank_creds "$name"; fi
        done < <(sessions)
    done
    exit 0
fi

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/sso-guard"
mkdir -p "$STATE"

# A login that needs a human: one persistent notification, login on click.
# Runs detached (its own transient unit) so waiting for the click never
# blocks the other sessions. Dismissed = re-ask at most every 2 h.
ask_login() { # $1 = session name
    local unit="sso-guard-ask-$1" m="$STATE/$1.needs-you"
    systemctl --user is-active --quiet "$unit" && return 0 # already asking
    [[ -n "$(find "$m.dismissed" -mmin -120 2>/dev/null)" ]] && return 0
    command -v notify-send >/dev/null 2>&1 || return 0
    systemd-run --user --quiet --collect --unit "$unit" --setenv=PATH="$PATH" bash -c '
        a=$(notify-send -u critical -t 0 -a sso-guard -A default="Log in" \
            "AWS SSO: $1 expired" "Click to log in (browser)")
        if [[ "$a" == default ]]; then
            aws sso login --sso-session "$1" && rm -f "$2" "$2.dismissed"
            systemctl --user start --no-block sso-guard.service
        else
            touch "$2.dismissed"
        fi' _ "$1" "$m" && echo "sso-guard: $1 needs you, notification posted"
}

expiry_for() { # $1 = start_url -> newest expiresAt epoch (0 if none)
    local best=0 f exp e
    for f in "$HOME"/.aws/sso/cache/*.json; do
        [[ -e "$f" ]] || continue
        exp=$(jq -r --arg u "$1" 'select(.startUrl == $u) | .expiresAt // empty' "$f" 2>/dev/null) || continue
        [[ -n "$exp" ]] || continue
        e=$(date -d "$exp" +%s 2>/dev/null) || continue
        (( e > best )) && best=$e
    done
    echo "$best"
}

# On-demand mode, called by the `aws` shim right before a command whose
# session token has expired: refresh it, or run the click-free browser login,
# so nothing ever needs a manual `aws sso login` after a break. The lock is
# shared with the loop below so concurrent callers (k9s fires get-token in
# parallel) and the timer open at most one browser tab.
ensure_session() { # $1 = session name -> 0 once it has a usable token
    local name=$1 url
    url=$(sessions | awk -F'\t' -v n="$name" '$1 == n { print $2 }')
    [[ -n "$url" ]] || { echo "sso-guard: no sso-session '$name' in $CONFIG" >&2; return 1; }
    exec 9>"$STATE/$name.lock"
    if ! flock -n 9; then
        # `sso-guard login` is a human at the keyboard: the tab the timer
        # opened (at boot, on another workspace...) is likely unseen, so
        # replace it with one in front of them instead of a silent 10 min wait.
        if [[ -n "${TAKEOVER:-}" ]]; then
            echo "sso-guard: $name: replacing the login already open in the browser" >&2
            pkill -u "$USER" -f "sso login --sso-session $name\$" || true
        else
            echo "sso-guard: $name: login already in progress, waiting for it" >&2
        fi
        flock -w 660 9 || return 1 # a login in flight times out after ~10 min
    fi
    fresh() { (( $(expiry_for "$url") - $(date +%s) > 60 )); }
    fresh && return 0 # another caller just logged in
    local rr=0
    refresh_silently "$url" || rr=$?
    (( rr == 0 )) && fresh && return 0
    if (( rr == 2 )); then
        echo "sso-guard: $name: no network, not logging in" >&2
        return 1
    fi
    if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        echo "sso-guard: $name needs interactive login (no display): aws sso login --sso-session $name" >&2
        return 1
    fi
    echo "sso-guard: $name session over, logging in (browser)" >&2
    # The browser aws spawns inherits its fds and can linger for minutes:
    # through a file, streamed live, so a caller reading our stderr through a
    # pipe (a script, an agent's shell) is not held open by the browser.
    local log pid rc=0
    log=$(mktemp)
    aws sso login --sso-session "$name" >"$log" 2>&1 9>&- &
    pid=$!
    tail -n +1 -s 0.2 -f --pid="$pid" "$log" >&2
    wait "$pid" || rc=$?
    rm -f "$log"
    (( rc == 0 )) || return 1
    rm -f "$STATE/$name.needs-you" "$STATE/$name.needs-you.dismissed"
    systemctl --user stop "sso-guard-ask-$name" >/dev/null 2>&1 || true # stale "log in" notification
}

if [[ ${1:-} == ensure ]]; then
    ensure_session "${2:?usage: sso-guard ensure <sso-session>}"
    exit
fi

# Every listed session (default: SSO_GUARD_SESSIONS, "*" = all) made usable
# now, all at once instead of one login after the other.
if [[ ${1:-} == login ]]; then
    shift
    names=("$@")
    if (( ${#names[@]} == 0 )); then
        if [[ "$BROWSER_SESSIONS" == "*" ]]; then
            mapfile -t names < <(sessions | awk -F'\t' '$3 != "" { print $1 }')
        else
            read -ra names <<<"$BROWSER_SESSIONS"
        fi
    fi
    declare -A job=()
    TAKEOVER=1
    # Background jobs ignore Ctrl-C: take them (and their aws/flock) down
    # with us, or each would open its own tab once the lock frees.
    trap 'for p in "${job[@]}"; do pkill -P "$p"; kill "$p"; done 2>/dev/null; exit 130' INT TERM
    for n in "${names[@]}"; do ensure_session "$n" </dev/null & job[$n]=$!; done
    rc=0
    for n in "${names[@]}"; do
        if wait "${job[$n]}"; then echo "sso-guard: $n ok"; else echo "sso-guard: $n FAILED" >&2; rc=1; fi
    done
    # Re-arm the timer from the new tokens.
    systemctl --user start --no-block sso-guard.service >/dev/null 2>&1 || true
    exit "$rc"
fi

rc=0
now=$(date +%s)
wake=0 # earliest epoch the next run should happen
want() { if (( $1 > 0 )) && (( wake == 0 || $1 < wake )); then wake=$1; fi; }
# Healthy token: wake 1 min before it dips under the threshold.
track() { want $(( $1 - MIN_SECONDS - 60 )); }

# One session's keep-alive pass, in its own background job; want/track/rc
# act on that job's copies, reported back through $results.
check_session() { # $1 = name, $2 = start url
    local name=$1 url=$2 e gated why ok
    e=$(expiry_for "$url")
    # +90s slack: the re-arm wakes 60s before the threshold, so act now
    # instead of sleeping 1 more minute and waking again.
    if (( e - now > MIN_SECONDS + 90 )); then
        rm -f "$STATE/$name.needs-you" "$STATE/$name.needs-you.dismissed"
        track "$e"; return 0
    fi

    # Sessions outside the allowlist are only worth keeping while something
    # uses them. Decide before spending a refresh call on a dead one.
    gated=0 why=""
    if [[ "$BROWSER_SESSIONS" != "*" && " $BROWSER_SESSIONS " != *" $name "* ]]; then
        gated=1
        why=$(in_use "$name") || why=$(used_recently "$name") || why=""
        if [[ -z "$why" ]] && (( e <= now )); then
            echo "sso-guard: $name expired, unused, letting it lapse (aws sso login --sso-session $name)"
            return 0
        fi
    fi

    # Access token low: mint a fresh one from the refresh token (no browser)
    # while the IdC session still lives.
    local rr=0
    refresh_silently "$url" || rr=$?
    if (( rr == 2 )); then
        echo "sso-guard: $name: no network, retry in 1 min"
        want $(( now + 60 )); return 0
    fi
    if (( rr == 0 )); then
        e=$(expiry_for "$url")
        # A full refresh buys ~60 min. Less means the IdC session itself
        # ends at $e: further refreshes or a browser login before then reuse
        # that same session and buy nothing, so sleep until it ends.
        if (( e - now > 3000 )); then
            echo "sso-guard: $name access token refreshed silently"
            track "$e"; return 0
        fi
        echo "sso-guard: $name session ends $(date -d "@$e" +%H:%M), login then"
        # Bank role creds 2 min before the end: as late as possible, so they outlive it most.
        if (( e - now > 180 )); then want $(( e - 120 )); else bank_creds "$name"; "$0" push || true; fi
        want $(( e + 30 )); return 0
    fi

    if (( gated )); then
        if [[ -z "$why" ]]; then
            echo "sso-guard: $name session over, unused, letting it lapse (aws sso login --sso-session $name)"
            return 0
        fi
        echo "sso-guard: $name in use ($why), re-login"
    fi

    if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        # One click-free browser attempt. If it times out, the browser IdP
        # session is gone too and a human is needed: ask once via a
        # notification instead of opening a new tab on every run.
        if [[ -e "$STATE/$name.needs-you" ]]; then
            ask_login "$name"; return 0
        fi
        exec 9>"$STATE/$name.lock"
        if ! flock -n 9; then
            echo "sso-guard: $name login already in progress (aws shim)"
            exec 9>&-; want $(( now + 120 )); return 0
        fi
        ok=0; aws sso login --sso-session "$name" 9>&- && ok=1 # the browser it spawns must not inherit the lock
        exec 9>&-
        if (( ok )); then
            track "$(expiry_for "$url")"
        else
            echo "sso-guard: $name browser login timed out, asking via notification instead of reopening the browser"
            touch "$STATE/$name.needs-you"
            ask_login "$name"
        fi
    else
        echo "sso-guard: '$name' needs interactive login (no display): aws sso login --sso-session $name" >&2
        rc=1
    fi
}

results=$(mktemp -d); trap 'rm -rf "$results"' EXIT
while IFS=$'\t' read -r name url profile; do
    [[ -n "$profile" ]] || continue # nothing consumes this session
    ( wake=0 rc=0; check_session "$name" "$url"; echo "$wake $rc" >"$results/$name" ) </dev/null &
done < <(sessions)
wait
for f in "$results"/*; do
    [[ -e "$f" ]] || continue
    read -r w r <"$f"
    want "$w"; (( r == 0 )) || rc=1
done

# Adaptive re-arm. Failure retries in 10 min; no data falls back to the
# hourly backstop timer. Clamped to [1 min, 6 h].
if command -v systemd-run >/dev/null 2>&1; then
    if (( rc != 0 )); then
        delay=600
    elif (( wake > 0 )); then
        delay=$(( wake - $(date +%s) ))
        if (( delay < 60 )); then delay=60; fi
        if (( delay > 21600 )); then delay=21600; fi
    else
        delay=0
    fi
    if (( delay > 0 )); then
        systemctl --user stop sso-guard-next.timer >/dev/null 2>&1 || true
        systemd-run --user --quiet --collect --unit sso-guard-next --timer-property=AccuracySec=1s \
            --on-active="${delay}s" systemctl --user start --no-block sso-guard.service \
            && echo "sso-guard: next check in $(( delay / 60 )) min"
    fi
fi
exit "$rc"
