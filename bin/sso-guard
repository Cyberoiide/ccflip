#!/usr/bin/env bash
# sso-guard — keep every AWS SSO session fresh so Bedrock sessions (and the
# litellm gateway, bastion tunnels, kubectl…) never die mid-flight with
# "Token is expired".
#
# Sessions are discovered from ~/.aws/config ([sso-session] blocks plus the
# first profile referencing each). Silent while an access token has life.
# When one runs low, a plain STS call lets botocore mint a fresh token from
# the SSO refresh token — no browser. Only when the refresh token itself is
# dead does it open the browser login (one click against a live IdP session),
# and only on a graphical session.
#
# Scheduling is adaptive: each run arms a transient timer to wake ~1 min
# before the earliest token crosses the threshold. The static hourly timer
# is only the reboot-safe backstop.
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

# sso-off disables the backstop timer; a run already in flight (or a stale
# sso-guard-next) must then do nothing and not re-arm itself.
if ! systemctl --user is-enabled --quiet sso-guard.timer 2>/dev/null; then
    echo "sso-guard: disabled (sso-off), skipping"
    exit 0
fi

MIN_SECONDS=$(( ${SSO_GUARD_MIN_MINUTES:-15} * 60 ))
# Sessions allowed to open a browser login when their IdC session ends
# (space-separated; "*" = all). Others are only kept alive silently: an
# org that caps sessions at 1h would otherwise mean a consent click per hour
# for a session nothing autonomous needs. Log in to those on demand.
BROWSER_SESSIONS="${SSO_GUARD_BROWSER:-*}"
CONFIG="${AWS_CONFIG_FILE:-$HOME/.aws/config}"

# Emit one "session<TAB>start_url<TAB>first_profile" line per sso-session.
sessions() {
    awk '
        /^\[sso-session /   { sec="s"; name=$2; sub(/\]$/,"",name); next }
        /^\[profile /       { sec="p"; prof=$2; sub(/\]$/,"",prof); next }
        /^\[/               { sec=""; next }
        sec=="s" && $1=="sso_start_url" { url[name]=$3 }
        sec=="p" && $1=="sso_session"   { if (!(($3) in prof_of)) prof_of[$3]=prof }
        END { for (n in url) printf "%s\t%s\t%s\n", n, url[n], prof_of[n] }
    ' "$CONFIG"
}

# Redeem the cached SSO refresh token directly (refresh_token grant) and write
# the new access token back into the cache file. An STS call does NOT do this:
# it is served from cached role creds (~/.aws/cli/cache) and never touches the
# SSO token, so every run used to fall through to a browser login + consent.
refresh_silently() { # $1 = start_url -> 0 if refreshed
    local f r tmp
    for f in "$HOME"/.aws/sso/cache/*.json; do
        [[ -e "$f" ]] || continue
        jq -e --arg u "$1" '.startUrl == $u and .refreshToken and .clientSecret' "$f" >/dev/null 2>&1 || continue
        r=$(aws sso-oidc create-token --output json --region "$(jq -r .region "$f")" \
            --grant-type refresh_token --client-id "$(jq -r .clientId "$f")" \
            --client-secret "$(jq -r .clientSecret "$f")" \
            --refresh-token "$(jq -r .refreshToken "$f")" 2>/dev/null) || continue
        tmp=$(mktemp "$f.XXXX")
        jq --argjson r "$r" --arg e "$(date -u -d "+$(jq -r .expiresIn <<<"$r") sec" +%FT%TZ)" \
            '.accessToken = $r.accessToken | .refreshToken = ($r.refreshToken // .refreshToken) | .expiresAt = $e' \
            "$f" >"$tmp" && chmod 600 "$tmp" && mv "$tmp" "$f" && return 0
        rm -f "$tmp"
    done
    return 1
}

expiry_for() { # $1 = start_url -> newest expiresAt epoch (0 if none)
    local best=0 f exp e
    for f in "$HOME"/.aws/sso/cache/*.json; do
        [[ -e "$f" ]] || continue
        exp=$(jq -r --arg u "$1" 'select(.startUrl == $u) | .expiresAt // empty' "$f" 2>/dev/null) || continue
        [[ -n "$exp" ]] || continue
        e=$(date -d "$exp" +%s 2>/dev/null) || continue
        (( e > best )) && best=$e
    done
    echo "$best"
}

rc=0
now=$(date +%s)
wake=0 # earliest epoch the next run should happen
want() { if (( $1 > 0 )) && (( wake == 0 || $1 < wake )); then wake=$1; fi; }
# Healthy token: wake 1 min before it dips under the threshold.
track() { want $(( $1 - MIN_SECONDS - 60 )); }

while IFS=$'\t' read -r name url profile; do
    [[ -n "$profile" ]] || continue # nothing consumes this session
    e=$(expiry_for "$url")
    # +90s slack: the re-arm wakes 60s before the threshold, so act now
    # instead of sleeping 1 more minute and waking again.
    if (( e - now > MIN_SECONDS + 90 )); then track "$e"; continue; fi

    # Access token low: mint a fresh one from the refresh token (no browser)
    # while the IdC session still lives.
    if refresh_silently "$url"; then
        e=$(expiry_for "$url")
        if (( e - now > MIN_SECONDS )); then
            echo "sso-guard: $name access token refreshed silently"
            track "$e"; continue
        fi
        # Refresh worked but came back short: the IdC session itself ends at
        # $e. A browser login now would reuse that same session (same end),
        # so it buys nothing; just come back right after it ends.
        echo "sso-guard: $name session ends $(date -d "@$e" +%H:%M), login then"
        want $(( e + 30 )); continue
    fi

    if [[ "$BROWSER_SESSIONS" != "*" && " $BROWSER_SESSIONS " != *" $name "* ]]; then
        echo "sso-guard: $name expired; silent-only, log in on demand: aws sso login --sso-session $name"
        continue
    fi

    if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        command -v notify-send >/dev/null 2>&1 && \
            notify-send -u critical "sso-guard" "AWS SSO session '$name' expired — complete the login in the browser"
        if aws sso login --sso-session "$name"; then
            track "$(expiry_for "$url")"
        else
            rc=1
        fi
    else
        echo "sso-guard: '$name' needs interactive login (no display): aws sso login --sso-session $name" >&2
        rc=1
    fi
done < <(sessions)

# Adaptive re-arm. Failure retries in 10 min; no data falls back to the
# hourly backstop timer. Clamped to [1 min, 6 h].
if command -v systemd-run >/dev/null 2>&1; then
    if (( rc != 0 )); then
        delay=600
    elif (( wake > 0 )); then
        delay=$(( wake - $(date +%s) ))
        if (( delay < 60 )); then delay=60; fi
        if (( delay > 21600 )); then delay=21600; fi
    else
        delay=0
    fi
    if (( delay > 0 )); then
        systemctl --user stop sso-guard-next.timer >/dev/null 2>&1 || true
        systemd-run --user --quiet --collect --unit sso-guard-next --timer-property=AccuracySec=1s \
            --on-active="${delay}s" systemctl --user start --no-block sso-guard.service \
            && echo "sso-guard: next check in $(( delay / 60 )) min"
    fi
fi
exit "$rc"
