#!/usr/bin/env bash
# ccflip — launch Claude Code on the right "account" for this directory.
#
# Mapped dir (cswap map):  its pinned account -> any other enabled usable
#                          account -> Bedrock.
# Anywhere else:           the default login (cswap auto guards it) ->
#                          Bedrock only when no subscription account works.
#
# ~/.claude/bedrock.env holds the per-host Bedrock config; source it
# manually to force Bedrock. Proactive rotation of the default login is the
# cswap-auto daemon's job — this launcher only routes.
#
# Also serves as t3code's claude binary (settings -> Claude -> binary path):
# t3code spawns it per session with the workspace as cwd, so mapped dirs and
# the Bedrock tier apply to t3code sessions too. GUI spawns may carry a
# minimal PATH, hence the prepend.
set -euo pipefail
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# `ccflip bedrock [claude args]` — explicitly launch on the Bedrock tier.
if [[ "${1:-}" == "bedrock" ]]; then
    shift
    BE="${CCFLIP_BEDROCK_ENV:-$HOME/.claude/bedrock.env}"
    [[ -f "$BE" ]] || { echo "ccflip: no $BE on this host" >&2; exit 1; }
    # shellcheck source=/dev/null
    . "$BE"
    exec claude "$@" # shim bypasses on CLAUDE_CODE_USE_BEDROCK
fi

# `ccflip budget` — the default account's REAL dollar meters. cswap only
# parses extra_usage (the overflow budget); the seat's included monthly pool
# arrives under an internal codename with limit_dollars — print any such
# bucket generically.
if [[ "${1:-}" == "budget" ]]; then
    {
        tok=$(jq -r '.claudeAiOauth.accessToken // empty' "$HOME/.claude/.credentials.json" 2>/dev/null)
        if [[ -n "$tok" ]]; then
            curl -s -m 10 https://api.anthropic.com/api/oauth/usage \
                 -H "Authorization: Bearer $tok" -H "anthropic-beta: oauth-2025-04-20" \
            | jq -r '
                (to_entries[] | select(.value.limit_dollars? != null)
                 | "\(.key)\t$\(.value.used_dollars) / $\(.value.limit_dollars)\t\(.value.utilization|round)%\tresets \(.value.resets_at // "?")"),
                (.extra_usage // empty
                 | "extra_usage (overflow)\t$\(.used_credits/100) / $\(.monthly_limit/100)\t\(.utilization)%\tmonthly")'
        else
            echo "oauth: no token in default profile"
        fi
        # Bedrock tier: YOUR consumption only — the AWS account is shared and
        # Cost Explorer cannot split by IAM principal, so sum this machine's
        # transcripts instead. Bedrock-served messages carry msg_bdrk_ ids.
        # Tokens, not dollars — no invented pricing table.
        find "$HOME/.claude/projects" \
             "${XDG_DATA_HOME:-$HOME/.local/share}/claude-swap/sessions" \
             -name '*.jsonl' -newermt "$(date +%Y-%m-01)" 2>/dev/null \
        | xargs -r cat 2>/dev/null \
        | jq -Rr 'fromjson? | select(.message.id? // "" | startswith("msg_bdrk_"))
                  | .message.usage // empty
                  | [(.output_tokens // 0),
                     (.input_tokens // 0) + (.cache_creation_input_tokens // 0)
                       + (.cache_read_input_tokens // 0)] | @tsv' 2>/dev/null \
        | awk -F'\t' '{o+=$1; i+=$2; n++} END {
              printf "bedrock (you, this host)\t%.2fM out / %.0fM in+cache\t%d msgs\tmonth-to-date\n",
                     o/1e6, i/1e6, n}'
    } | column -t -s $'\t'
    exit 0
fi

# `ccflip who` — which account is every running claude session on?
# bedrock | <n-email-slug> (pinned session) | default-login email.
# ponytail: /proc scan, Linux only; matches the native-installer binary
# (exe under .../claude/versions/) and anything literally named claude.
if [[ "${1:-}" == "who" ]]; then
    default_acct=$(jq -r '.oauthAccount.emailAddress // "?"' "$HOME/.claude.json" 2>/dev/null)
    printf '%-9s %-45s %s\n' PID ACCOUNT CWD
    for p in /proc/[0-9]*; do
        exe=$(readlink "$p/exe" 2>/dev/null) || continue
        [[ "$exe" == */claude/versions/* || "${exe##*/}" == claude ]] || continue
        envs=$(tr '\0' '\n' < "$p/environ" 2>/dev/null) || continue
        if grep -q '^CLAUDE_CODE_USE_BEDROCK=' <<<"$envs"; then acct=bedrock
        elif cfg=$(grep -m1 '^CLAUDE_CONFIG_DIR=' <<<"$envs"); then acct=$(basename "${cfg#*=}")
        else acct=$default_acct; fi
        printf '%-9s %-45s %s\n' "${p#/proc/}" "$acct" "$(readlink "$p/cwd" 2>/dev/null)"
    done
    exit 0
fi

BEDROCK_ENV="${CCFLIP_BEDROCK_ENV:-$HOME/.claude/bedrock.env}"
MAPPINGS="${CCFLIP_MAPPINGS:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-swap/mappings.json}"
THRESHOLD="${CCFLIP_THRESHOLD:-99}" # launcher acts only on truly-dry windows
# Spend-based accounts (enterprise budget) count as dry near their cap, so
# routing falls to the next tier before requests start failing.
SPEND_THRESHOLD="${CCFLIP_SPEND_THRESHOLD:-97}"

command -v cswap >/dev/null 2>&1 || exec claude "$@"
LIST=$(cswap list --json 2>/dev/null) || exec claude "$@"

usable() { # $1 = jq selector for one account row
    jq -e --argjson thr "$THRESHOLD" --argjson sthr "$SPEND_THRESHOLD" \
       "$1 | select(.usageStatus == \"ok\")
           | ((.usage.fiveHour == null)
              or ([.usage.fiveHour.pct, .usage.sevenDay.pct] | max < \$thr))
             and ((.usage.spend == null) or (.usage.spend.pct < \$sthr))" \
       <<<"$LIST" >/dev/null 2>&1
}

go_subscription() { # $@ = cswap run args
    # A stale Bedrock env (shell that sourced bedrock.env, process started
    # under old always-on settings) must not leak through — cswap scrubs
    # auth-token overrides but not the Bedrock switches.
    unset CLAUDE_CODE_USE_BEDROCK AWS_BEARER_TOKEN_BEDROCK \
          ANTHROPIC_BEDROCK_BASE_URL ANTHROPIC_MODEL
    exec cswap run "$@"
}

go_bedrock() { # $1 = reason, rest = claude args
    local reason=$1; shift
    if [[ -f "$BEDROCK_ENV" ]]; then
        echo "ccflip: $reason -> Bedrock" >&2
        # A mapped dir's conversation history lives in its pinned profile —
        # keep that profile so sessions resume across tiers (Bedrock SigV4
        # auth ignores the profile's subscription credentials).
        if [[ -n "${mapped_email:-}" ]]; then
            local prof
            prof=$(printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/claude-swap/sessions/"*"-${mapped_email/@/_}" | head -1)
            [[ -d "$prof" ]] && export CLAUDE_CONFIG_DIR="$prof"
        fi
        # shellcheck source=/dev/null
        . "$BEDROCK_ENV"
        # An explicit --model flag (t3code always sends one) beats every env
        # var, and slot vars like ANTHROPIC_DEFAULT_FABLE_MODEL do not remap
        # it. Hosts whose IAM role lacks the requested model set
        # CCFLIP_BEDROCK_MODEL_OVERRIDE in bedrock.env; we rewrite the flag.
        if [[ -n "${CCFLIP_BEDROCK_MODEL_OVERRIDE:-}" ]]; then
            local out=() expect=0 a
            for a in "$@"; do
                if (( expect )); then out+=("$CCFLIP_BEDROCK_MODEL_OVERRIDE"); expect=0; continue; fi
                case "$a" in
                    --model)   out+=("$a"); expect=1 ;;
                    --model=*) out+=("--model=$CCFLIP_BEDROCK_MODEL_OVERRIDE") ;;
                    *)         out+=("$a") ;;
                esac
            done
            set -- "${out[@]}"
        fi
        exec claude "$@"
    fi
    echo "ccflip: $reason and no $BEDROCK_ENV — launching anyway" >&2
    go_subscription -- "$@"
}

mapped_email=$(jq -r --arg pwd "$PWD" '
    (.mappings // {}) | to_entries
    | map(.key as $k | select(($k == $pwd) or ($pwd | startswith($k + "/"))))
    | sort_by(.key | length) | last | .value.email // empty' \
    "$MAPPINGS" 2>/dev/null || true)

if [[ -n "$mapped_email" ]]; then
    if usable ".accounts[] | select(.email == \"$mapped_email\")"; then
        go_subscription -- "$@" # bare run resolves the mapping itself
    fi
    # Pinned account is dry: any other enabled usable account may serve this
    # dir (disabled accounts are dir-pinned only — never borrowed here).
    alt=$(jq -r --arg skip "$mapped_email" --argjson thr "$THRESHOLD" --argjson sthr "$SPEND_THRESHOLD" '
        [.accounts[] | select(.email != $skip and (.disabled | not)
                              and .usageStatus == "ok"
                              and (((.usage.fiveHour != null)
                                    and ([.usage.fiveHour.pct, .usage.sevenDay.pct] | max < $thr))
                                   or ((.usage.spend != null) and (.usage.spend.pct < $sthr))))]
        | sort_by(.usage.fiveHour.pct // -1) | first | .email // empty' <<<"$LIST")
    if [[ -n "$alt" ]]; then
        echo "ccflip: $mapped_email exhausted -> $alt" >&2
        go_subscription "$alt" -- "$@"
    fi
    go_bedrock "every usable subscription account exhausted" "$@"
fi

# Unmapped dir: the default login, unless it is dead/dry. If another enabled
# account could replace it, launch anyway — the cswap-auto daemon moves the
# default login, not us.
active=$(jq -r '.activeAccountNumber' <<<"$LIST")
if usable ".accounts[] | select(.number == $active)"; then
    go_subscription -- "$@"
fi
if jq -e --argjson thr "$THRESHOLD" --argjson sthr "$SPEND_THRESHOLD" '
      [.accounts[] | select((.disabled | not) and .usageStatus == "ok"
                            and (((.usage.fiveHour != null)
                                  and ([.usage.fiveHour.pct, .usage.sevenDay.pct] | max < $thr))
                                 or ((.usage.spend != null) and (.usage.spend.pct < $sthr))))]
      | length > 0' <<<"$LIST" >/dev/null; then
    go_subscription -- "$@"
fi
go_bedrock "no usable subscription account" "$@"
