#!/usr/bin/env bash
# ccflip-watch — mid-session account rotation for PINNED sessions.
#
# `cswap auto` (its own systemd unit) rotates only the default login and
# deliberately skips accounts owned by live `cswap run` sessions. This watcher
# covers the gap: when a pinned session's account exhausts a usage window, it
# writes the best remaining account's credentials into that session's profile
# (CLAUDE_CONFIG_DIR scopes every cswap path), which Claude Code picks up on
# its next token refresh — no restart.
#
# Rotating a session profile with no live process is harmless: the next
# `cswap run` re-seeds it. So no PID tracking here.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

INTERVAL="${CCFLIP_WATCH_INTERVAL:-60}"
# Later than cswap auto's default 90: the watcher is the last-resort lever.
THRESHOLD="${CCFLIP_WATCH_THRESHOLD:-95}"
SESSIONS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/claude-swap/sessions"
POLICY="${CCFLIP_POLICY:-$HOME/.config/ccflip/policy.env}"
SPEND_ALERT_PCT="${CCFLIP_SPEND_ALERT_PCT:-90}"
SPEND_THRESHOLD="${CCFLIP_SPEND_THRESHOLD:-97}"

log() { printf '%s %s\n' "$(date -Is)" "$*"; }

# Warn once per breach when a spend-budget account (enterprise $ cap) crosses
# the alert line — journal always, desktop notification when available.
declare -A SPEND_ALERTED
spend_alert() { # stdin: cswap list --json
    local line email pct
    while IFS=$'\t' read -r email pct; do
        if (( $(printf '%.0f' "$pct") >= SPEND_ALERT_PCT )); then
            [[ -n "${SPEND_ALERTED[$email]:-}" ]] && continue
            SPEND_ALERTED[$email]=1
            log "SPEND ALERT: $email at ${pct}% of its budget (alert line ${SPEND_ALERT_PCT}%)"
            command -v notify-send >/dev/null 2>&1 && \
                notify-send -u critical "ccflip" "$email at ${pct}% of spend budget" 2>/dev/null
        else
            unset "SPEND_ALERTED[$email]"
        fi
    done < <(jq -r '.accounts[] | select(.usage.spend != null)
                    | [.email, .usage.spend.pct] | @tsv' 2>/dev/null)
}

# Account containment guard. `cswap import` re-activates a replaced slot and
# clears its disabled flag, and nothing else re-checks intent — so a token
# refresh can silently make a pinned-only (personal) account the default
# login. Enforce the declared policy every tick: a CCFLIP_PINNED_ONLY account
# found active is switched away from, and one found enabled is re-disabled.
enforce_policy() {
    [[ -f "$POLICY" ]] || return 0
    # shellcheck source=/dev/null
    . "$POLICY"
    [[ -n "${CCFLIP_PINNED_ONLY:-}" ]] || return 0
    local list active a
    list=$(cswap list --json 2>/dev/null) || return 0
    active=$(jq -r '[.accounts[] | select(.active == true) | .email] | first // empty' <<<"$list")
    for a in $CCFLIP_PINNED_ONLY; do
        if [[ "$active" == "$a" && -n "${CCFLIP_DEFAULT_ACCOUNT:-}" ]]; then
            if cswap switch "$CCFLIP_DEFAULT_ACCOUNT" >/dev/null 2>&1; then
                log "policy: pinned-only $a was the default login -> switched back to $CCFLIP_DEFAULT_ACCOUNT"
            else
                log "policy: pinned-only $a is the default login and switch to $CCFLIP_DEFAULT_ACCOUNT FAILED"
            fi
        fi
        if jq -e --arg e "$a" '.accounts[] | select(.email == $e and (.disabled | not))' <<<"$list" >/dev/null 2>&1; then
            cswap disable "$a" >/dev/null 2>&1 && log "policy: re-disabled pinned-only account $a"
        fi
    done
}

# Emit the target account number for a session, or nothing.
# Exhausted = usageStatus not ok, or either window >= THRESHOLD.
# Target    = enabled ok windowed account with the most headroom; a
# spend-based account (enterprise/API billing, no 5h/7d windows) is the
# LAST-RESORT target — it costs real dollars, so windowed quota goes first.
# Accounts with no usage data at all are never targets (fail-safe hold).
pick_target() { # $1=current account number  (stdin: cswap list --json)
    jq -r --argjson num "$1" --argjson thr "$THRESHOLD" --argjson sthr "$SPEND_THRESHOLD" '
        def windowed: .usage.fiveHour != null;
        def spendonly: (.usage != null) and (.usage.fiveHour == null)
                       and ((.usage.spend == null) or (.usage.spend.pct < $sthr));
        def worst: [.usage.fiveHour.pct, .usage.sevenDay.pct] | max;
        .accounts as $a
        | ($a[] | select(.number == $num)) as $cur
        | if ($cur.usageStatus != "ok")
             or (($cur | windowed) and ($cur | worst) >= $thr)
          then [ $a[]
                 | select(.number != $num
                          and (.disabled | not)
                          and .usageStatus == "ok"
                          and ((windowed and worst < $thr) or spendonly)) ]
               | sort_by([(if windowed then 0 else 1 end), (worst // -1)])
               | first | .number // empty
          else empty end'
}

tick() {
    local list dir name num target
    list=$(cswap list --json 2>/dev/null) || return 0
    spend_alert <<<"$list"
    [[ -d "$SESSIONS_DIR" ]] || return 0
    for dir in "$SESSIONS_DIR"/*/; do
        [[ -d "$dir" ]] || continue
        name=$(basename "$dir")
        num="${name%%-*}"
        [[ "$num" =~ ^[0-9]+$ ]] || continue
        target=$(pick_target "$num" <<<"$list") || continue
        [[ -n "$target" ]] || continue
        if CLAUDE_CONFIG_DIR="${dir%/}" cswap switch "$target" >/dev/null 2>&1; then
            log "session '$name' exhausted -> switched profile to account $target"
        else
            log "session '$name': switch to account $target failed (will retry)"
        fi
    done
}

log "ccflip-watch started (interval=${INTERVAL}s threshold=${THRESHOLD}%)"
while :; do
    enforce_policy
    tick
    sleep "$INTERVAL"
done
