#!/usr/bin/env bash
# ccflip-watch — mid-session account rotation for PINNED sessions.
#
# `cswap auto` (its own systemd unit) rotates only the default login and
# deliberately skips accounts owned by live `cswap run` sessions. This watcher
# covers the gap: when a pinned session's account exhausts a usage window, it
# writes the best remaining account's credentials into that session's profile
# (CLAUDE_CONFIG_DIR scopes every cswap path), which Claude Code picks up on
# its next token refresh — no restart.
#
# Rotating a session profile with no live process is harmless: the next
# `cswap run` re-seeds it. So no PID tracking here.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

INTERVAL="${CCFLIP_WATCH_INTERVAL:-60}"
# Later than cswap auto's default 90: the watcher is the last-resort lever.
THRESHOLD="${CCFLIP_WATCH_THRESHOLD:-95}"
SESSIONS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/claude-swap/sessions"
POLICY="${CCFLIP_POLICY:-$HOME/.config/ccflip/policy.env}"
SPEND_ALERT_PCT="${CCFLIP_SPEND_ALERT_PCT:-90}"
SPEND_THRESHOLD="${CCFLIP_SPEND_THRESHOLD:-97}"

log() { printf '%s %s\n' "$(date -Is)" "$*"; }

# Warn once per breach when any dollar meter crosses the alert line —
# journal always, desktop notification when available. Re-arms if it drops.
declare -A SPEND_ALERTED
alert_pct() { # $1 = meter name, $2 = pct
    local name=$1 pct=$2
    if (( $(printf '%.0f' "$pct") >= SPEND_ALERT_PCT )); then
        [[ -n "${SPEND_ALERTED[$name]:-}" ]] && return 0
        SPEND_ALERTED[$name]=1
        log "SPEND ALERT: $name at ${pct}% of its budget (alert line ${SPEND_ALERT_PCT}%)"
        command -v notify-send >/dev/null 2>&1 && \
            notify-send -u critical "ccflip" "$name at ${pct}% of spend budget" 2>/dev/null
    else
        unset "SPEND_ALERTED[$name]"
    fi
}

spend_alert() { # stdin: cswap list --json
    local email pct
    while IFS=$'\t' read -r email pct; do
        alert_pct "$email" "$pct"
    done < <(jq -r '.accounts[] | select(.usage.spend != null)
                    | [.email, .usage.spend.pct] | @tsv' 2>/dev/null)
}

# cswap only surfaces extra_usage (the overflow budget). The seat's included
# monthly pool is a separate limit_dollars bucket on the oauth usage API —
# poll it directly (every 5th tick, spare the endpoint) so "close to 100%"
# means the meter that actually drains first.
BUDGET_TICK=0
budget_alert() {
    (( BUDGET_TICK++ % 5 == 0 )) || return 0
    local tok payload name pct
    tok=$(jq -r '.claudeAiOauth.accessToken // empty' "$HOME/.claude/.credentials.json" 2>/dev/null)
    [[ -n "$tok" ]] || return 0
    payload=$(curl -s -m 10 https://api.anthropic.com/api/oauth/usage \
              -H "Authorization: Bearer $tok" -H "anthropic-beta: oauth-2025-04-20" 2>/dev/null) || return 0
    while IFS=$'\t' read -r name pct; do
        alert_pct "$name" "$pct"
    done < <(jq -r '(to_entries[] | select(.value.limit_dollars? != null)
                     | [.key, .value.utilization]),
                    (.extra_usage // empty | ["extra_usage", .utilization])
                    | @tsv' <<<"$payload" 2>/dev/null)
}

# Account containment guard. `cswap import` re-activates a replaced slot and
# clears its disabled flag, and nothing else re-checks intent — so a token
# refresh can silently make a pinned-only (personal) account the default
# login. Enforce the declared policy every tick: a CCFLIP_PINNED_ONLY account
# found active is switched away from, and one found enabled is re-disabled.
enforce_policy() {
    [[ -f "$POLICY" ]] || return 0
    # shellcheck source=/dev/null
    . "$POLICY"
    [[ -n "${CCFLIP_PINNED_ONLY:-}" ]] || return 0
    local list active a
    list=$(cswap list --json 2>/dev/null) || return 0
    active=$(jq -r '[.accounts[] | select(.active == true) | .email] | first // empty' <<<"$list")
    for a in $CCFLIP_PINNED_ONLY; do
        if [[ "$active" == "$a" && -n "${CCFLIP_DEFAULT_ACCOUNT:-}" ]]; then
            if cswap switch "$CCFLIP_DEFAULT_ACCOUNT" >/dev/null 2>&1; then
                log "policy: pinned-only $a was the default login -> switched back to $CCFLIP_DEFAULT_ACCOUNT"
            else
                log "policy: pinned-only $a is the default login and switch to $CCFLIP_DEFAULT_ACCOUNT FAILED"
            fi
        fi
        if jq -e --arg e "$a" '.accounts[] | select(.email == $e and (.disabled | not))' <<<"$list" >/dev/null 2>&1; then
            cswap disable "$a" >/dev/null 2>&1 && log "policy: re-disabled pinned-only account $a"
        fi
    done
}

# Emit the target account number for a session, or nothing.
# Exhausted = usageStatus not ok, or either window >= THRESHOLD.
# Target    = enabled ok windowed account with the most headroom; a
# spend-based account (enterprise/API billing, no 5h/7d windows) is the
# LAST-RESORT target — it costs real dollars, so windowed quota goes first.
# Accounts with no usage data at all are never targets (fail-safe hold).
pick_target() { # $1=current account number  (stdin: cswap list --json)
    jq -r --argjson num "$1" --argjson thr "$THRESHOLD" --argjson sthr "$SPEND_THRESHOLD" '
        def windowed: .usage.fiveHour != null;
        def spendonly: (.usage != null) and (.usage.fiveHour == null)
                       and ((.usage.spend == null) or (.usage.spend.pct < $sthr));
        def worst: [.usage.fiveHour.pct, .usage.sevenDay.pct] | max;
        .accounts as $a
        | ($a[] | select(.number == $num)) as $cur
        | if ($cur.usageStatus != "ok")
             or (($cur | windowed) and ($cur | worst) >= $thr)
          then [ $a[]
                 | select(.number != $num
                          and (.disabled | not)
                          and .usageStatus == "ok"
                          and ((windowed and worst < $thr) or spendonly)) ]
               | sort_by([(if windowed then 0 else 1 end), (worst // -1)])
               | first | .number // empty
          else empty end'
}

# --- mid-session tier switching ---------------------------------------------
# Creds rotation covers subscription->subscription, but Bedrock needs env vars
# a live process cannot receive. The conversation is the session id, not the
# process: SDK harnesses (t3code, claude-mem) respawn a killed process on the
# next message with the same session. So: a harness-spawned process whose
# account is exhausted with no rotation target is killed (its requests fail
# anyway) and revives on Bedrock; a Bedrock process whose subscription tier is
# usable again is killed once its transcript has been idle, and revives on the
# account. Terminal-spawned sessions are never touched.
SWITCHBACK_IDLE="${CCFLIP_SWITCHBACK_IDLE:-300}"
PROC_MIN_AGE="${CCFLIP_PROC_MIN_AGE:-120}"

acct_usable() { # $1=list json, $2=email
    jq -e --arg e "$2" --argjson thr "$THRESHOLD" --argjson sthr "$SPEND_THRESHOLD" '
        [.accounts[] | select(.email == $e and .usageStatus == "ok"
          and ((.usage.fiveHour == null) or ([.usage.fiveHour.pct, .usage.sevenDay.pct] | max < $thr))
          and ((.usage.spend == null) or (.usage.spend.pct < $sthr)))]
        | length > 0' <<<"$1" >/dev/null 2>&1
}

has_enabled_usable() { # $1=list json
    jq -e --argjson thr "$THRESHOLD" --argjson sthr "$SPEND_THRESHOLD" '
        [.accounts[] | select((.disabled | not) and .usageStatus == "ok"
          and ((.usage.fiveHour == null) or ([.usage.fiveHour.pct, .usage.sevenDay.pct] | max < $thr))
          and ((.usage.spend == null) or (.usage.spend.pct < $sthr)))]
        | length > 0' <<<"$1" >/dev/null 2>&1
}

mapped_email_for() { # $1=cwd
    jq -r --arg pwd "$1" '
        (.mappings // {}) | to_entries
        | map(.key as $k | select(($k == $pwd) or ($pwd | startswith($k + "/"))))
        | sort_by(.key | length) | last | .value.email // empty' \
        "${XDG_DATA_HOME:-$HOME/.local/share}/claude-swap/mappings.json" 2>/dev/null || true
}

# Would a fresh ccflip launch in this cwd land on a subscription account?
has_subscription_for() { # $1=list json, $2=cwd
    local m; m=$(mapped_email_for "$2")
    if [[ -n "$m" ]] && acct_usable "$1" "$m"; then return 0; fi
    has_enabled_usable "$1"
}

transcript_idle() { # $1=config dir ("" = default profile), $2=cwd
    local base="${1:-$HOME/.claude}" slug
    slug=$(sed 's/[/.]/-/g' <<<"$2")
    [[ -z "$(find "$base/projects/$slug" -name '*.jsonl' \
             -mmin -$(( SWITCHBACK_IDLE / 60 )) 2>/dev/null | head -1)" ]]
}

switch_tick() { # $1=list json
    local p pid exe envs cfg cwd num email ppid pcomm now
    now=$(date +%s)
    for p in /proc/[0-9]*; do
        exe=$(readlink "$p/exe" 2>/dev/null) || continue
        [[ "$exe" == */claude/versions/* || "${exe##*/}" == claude ]] || continue
        pid="${p#/proc/}"
        # Only harness-spawned processes auto-respawn; never kill terminals.
        ppid=$(awk '/^PPid:/{print $2}' "$p/status" 2>/dev/null) || continue
        pcomm=$(cat "/proc/$ppid/comm" 2>/dev/null) || continue
        case "$pcomm" in node*|bun*|t3code*|electron*) ;; *) continue ;; esac
        (( now - $(stat -c %Y "$p" 2>/dev/null || echo "$now") < PROC_MIN_AGE )) && continue
        cwd=$(readlink "$p/cwd" 2>/dev/null) || continue
        [[ "$cwd" == *claude-mem* ]] && continue
        envs=$(tr '\0' '\n' < "$p/environ" 2>/dev/null) || continue

        if grep -q '^CLAUDE_CODE_USE_BEDROCK=' <<<"$envs"; then
            # Bedrock session: move back once a subscription tier is usable.
            if has_subscription_for "$1" "$cwd" && transcript_idle "" "$cwd"; then
                kill "$pid" 2>/dev/null && \
                    log "switchback: ended bedrock process $pid ($cwd) — subscription usable again, session revives on it"
            fi
            continue
        fi

        cfg=$(grep -m1 '^CLAUDE_CONFIG_DIR=' <<<"$envs" | cut -d= -f2- || true)
        if [[ -n "$cfg" ]]; then
            num=$(basename "$cfg"); num="${num%%-*}"
            [[ "$num" =~ ^[0-9]+$ ]] || continue
            email=$(jq -r --argjson n "$num" '.accounts[] | select(.number == $n) | .email' <<<"$1")
            acct_usable "$1" "$email" && continue
            [[ -n "$(pick_target "$num" <<<"$1")" ]] && continue # creds rotation covers it
        else
            email=$(jq -r '[.accounts[] | select(.active == true) | .email] | first // empty' <<<"$1")
            acct_usable "$1" "$email" && continue
            has_enabled_usable "$1" && continue # rotation/launcher covers it
        fi
        kill "$pid" 2>/dev/null && \
            log "failover: ended process $pid on exhausted ${email:-?} ($cwd) — session revives on Bedrock"
    done
}

tick() {
    local list dir name num target
    list=$(cswap list --json 2>/dev/null) || return 0
    spend_alert <<<"$list"
    switch_tick "$list"
    [[ -d "$SESSIONS_DIR" ]] || return 0
    for dir in "$SESSIONS_DIR"/*/; do
        [[ -d "$dir" ]] || continue
        name=$(basename "$dir")
        num="${name%%-*}"
        [[ "$num" =~ ^[0-9]+$ ]] || continue
        target=$(pick_target "$num" <<<"$list") || continue
        [[ -n "$target" ]] || continue
        if CLAUDE_CONFIG_DIR="${dir%/}" cswap switch "$target" >/dev/null 2>&1; then
            log "session '$name' exhausted -> switched profile to account $target"
        else
            log "session '$name': switch to account $target failed (will retry)"
        fi
    done
}

log "ccflip-watch started (interval=${INTERVAL}s threshold=${THRESHOLD}%)"
while :; do
    enforce_policy
    tick
    budget_alert
    sleep "$INTERVAL"
done
